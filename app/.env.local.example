# Copia a .env.local (no se sube a git) y rellena con tus claves reales.

NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
# Solo para uso en servidor (API routes), nunca exponer en cliente:
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# LLM
OPENROUTER_API_KEY=tu-openrouter-key
OPENAI_API_KEY=tu-openai-key

# n8n (para que Next.js dispare workflows si hace falta)
N8N_WEBHOOK_BASE_URL=http://localhost:5678

# Secreto compartido con n8n para el webhook que envía WhatsApp desde la
# bandeja. Tiene que coincidir con `PANEL_WEBHOOK_TOKEN` en `n8n/.env`: sin él,
# n8n rechaza el envío.
N8N_WEBHOOK_TOKEN=

# Notificaciones push (Web Push). Se generan una vez con
# `npx web-push generate-vapid-keys` y deben ser LAS MISMAS que en el servidor:
# si cambian, todos los móviles suscritos dejan de recibir avisos y hay que
# volver a dar permiso en cada uno.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@agenciakivuk.com

# Servicio de imagen (carpeta /render). Compone las piezas y convierte a JPEG
# lo que se sube a mano desde el panel.
RENDER_BASE_URL=http://localhost:3001

# Envío de facturas por correo desde el panel. Es la cuenta de Resend de la
# AGENCIA (dominio agenciakivuk.com, ya verificado), no la del cliente que se
# usa para los avisos: aquí quien escribe eres tú, no su negocio.
RESEND_API_KEY=
FACTURAS_REMITENTE="Kivuk Agencia <facturacion@agenciakivuk.com>"
