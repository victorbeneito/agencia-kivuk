    {
      "parameters": {
        "jsCode": "const pet = $('Leer petición').first().json;\nconst pieza = $('Cargar pieza').first().json || {};\nconst cuentas = $input.all().map((i) => i.json).filter((c) => c && c.platform);\n\nconst no = (motivo) => [{ json: { listo: false, motivo, content_item_id: pet.content_item_id } }];\n\nif (!pet.content_item_id) return no('No has indicado qué pieza publicar.');\nif (!pieza.id) return no('Esa pieza no existe.');\n\n// Solo se publica lo aprobado. Es la regla que sostiene todo el módulo: nada\n// sale a la calle sin que una persona lo haya visto.\nconst PUBLICABLES = ['approved', 'scheduled'];\nif (!PUBLICABLES.includes(pieza.status)) {\n  return no(pieza.status === 'published'\n    ? 'Esa pieza ya está publicada.'\n    : 'Esa pieza está en «' + pieza.status + '»; solo se publica lo aprobado.');\n}\n\nconst medios = (pieza.media_urls || []).filter(Boolean);\nif (!medios.length) return no('Esa pieza no tiene imagen.');\nif (medios.length > 1) return no('Los carruseles todavía no se publican; esta pieza tiene ' + medios.length + ' imágenes.');\nif (pieza.format === 'reel') return no('Los reels todavía no se publican.');\n\n// En Facebook los hashtags no aportan y ensucian: se quita el bloque final.\nconst sinHashtags = (t) => String(t || '')\n  .split('\\n')\n  .filter((l) => !/^\\s*(#[\\p{L}\\p{N}_]+\\s*)+$/u.test(l))\n  .join('\\n')\n  .trim();\n\nconst pedidas = pet.redes.length ? pet.redes : ['instagram', 'facebook'];\nconst tareas = [];\n\nfor (const red of pedidas) {\n  const cuenta = cuentas.find((c) => c.platform === red);\n  if (!cuenta) continue;               // red no conectada: se ignora, no es un error\n\n  // Facebook no publica stories por API; Instagram sí.\n  if (red === 'facebook' && pieza.format === 'story') continue;\n\n  tareas.push({\n    listo: true,\n    red,\n    content_item_id: pieza.id,\n    client_id: pieza.client_id,\n    formato: pieza.format,\n    cuenta_id: cuenta.external_id,\n    usuario: cuenta.username || cuenta.external_id,\n    token: cuenta.access_token,\n    imagen: medios[0],\n    texto: red === 'facebook' ? sinHashtags(pieza.caption) : String(pieza.caption || ''),\n    // STORIES para las stories; para el resto, imagen normal.\n    media_type: pieza.format === 'story' ? 'STORIES' : 'IMAGE',\n  });\n}\n\nif (!tareas.length) {\n  return no(cuentas.length\n    ? 'Ninguna de las redes pedidas está conectada para este cliente.'\n    : 'Este cliente no tiene ninguna cuenta conectada. Ejecuta scripts/conectar-meta.js.');\n}\n\nreturn tareas.map((json) => ({ json }));"
      },
