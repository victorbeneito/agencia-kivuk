    {
      "parameters": {
        "jsCode": "const cuerpo = $json.body || {};\n\n// Se acepta tanto una pieza suelta como una lista, para poder publicar un lote\n// entero desde el panel sin llamar al webhook nueve veces.\nconst ids = []\n  .concat(cuerpo.content_item_id || [], cuerpo.content_item_ids || [])\n  .map((x) => String(x || '').trim())\n  .filter(Boolean);\n\n// Por omisión se publica en todas las redes conectadas del cliente. Se puede\n// acotar con { \"redes\": [\"instagram\"] }.\nconst redes = (Array.isArray(cuerpo.redes) ? cuerpo.redes : [])\n  .map((r) => String(r).toLowerCase().trim())\n  .filter((r) => r === 'instagram' || r === 'facebook');\n\nreturn [{ json: { content_item_id: ids[0] || '', redes } }];"
      },
