    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const plan = $('Retomar plan').item.json;\nconst r = $json || {};\nconst cuerpo = r.body || {};\n\nif (r.statusCode >= 400 || cuerpo.error) {\n  const e = cuerpo.error || {};\n  return { json: { red: 'facebook', content_item_id: plan.content_item_id,\n    usuario: plan.usuario, ok: false,\n    error: 'Facebook: ' + (e.message || 'error ' + r.statusCode) } };\n}\n\n// /photos devuelve el id de la foto y el del post; el que sirve para enlazar a\n// la publicación es post_id.\nreturn { json: { red: 'facebook', content_item_id: plan.content_item_id,\n  usuario: plan.usuario, ok: true, post_id: cuerpo.post_id || cuerpo.id } };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        460
      ],
      "name": "FB resultado",
      "id": "pb000022-0022-4022-8022-000000000022"
    },
    {
      "parameters": {
        "mode": "append",
        "numberInputs": 2
      },
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        3400,
        300
      ],
      "name": "Unir resultados",
      "id": "pb000023-0023-4023-8023-000000000023"
    },
    {
      "parameters": {
        "jsCode": "const resultados = $input.all().map((i) => i.json);\nconst ok = resultados.filter((r) => r.ok);\nconst fallos = resultados.filter((r) => !r.ok);\n\nconst itemId = (resultados[0] || {}).content_item_id ||\n  $('Leer petición').first().json.content_item_id;\n\n// La pieza se da por publicada si salió en al menos una red. Marcarla como\n// fallida porque Facebook falló, cuando Instagram sí publicó, obligaría a\n// republicar y duplicaría el post de Instagram.\nconst estado = ok.length ? 'published' : 'failed';\n\nconst publicaciones = {};\nfor (const r of resultados) {\n  publicaciones[r.red] = r.ok\n    ? { post_id: r.post_id, usuario: r.usuario, publicado_en: new Date().toISOString() }\n    : { error: r.error };\n}\n\nreturn [{\n  json: {\n    content_item_id: itemId,\n    estado,\n    // external_post_id se queda con el de Instagram por ser la red principal\n    // del módulo; el detalle completo de cada red va en meta.publicaciones.\n    external_post_id: (ok.find((r) => r.red === 'instagram') || ok[0] || {}).post_id || null,\n    published_at: ok.length ? new Date().toISOString() : null,\n    error: fallos.length ? fallos.map((f) => f.error).join(' | ') : null,\n    publicaciones,\n    mensaje: ok.length\n      ? 'Publicado en ' + ok.map((r) => r.red).join(' y ') +\n        (fallos.length ? '. Falló en ' + fallos.map((r) => r.red).join(' y ') + '.' : '.')\n      : 'No se pudo publicar. ' + fallos.map((f) => f.error).join(' | '),\n    ok: ok.length > 0,\n  },\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3600,
