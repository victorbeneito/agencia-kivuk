    {
      "parameters": {
        "url": "=https://graph.facebook.com/{{ $env.META_API_VERSION || 'v25.0' }}/{{ $json.contenedor }}",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "fields",
              "value": "status_code,status"
