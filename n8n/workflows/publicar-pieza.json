      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const plan = $('Retomar plan').item.json;\nconst r = $json || {};\nconst cuerpo = r.body || {};\n\nif (r.statusCode >= 400 || cuerpo.error) {\n  const e = cuerpo.error || {};\n  return { json: { ...plan, ok: false, intento: 0,\n    fallo: 'No se pudo preparar la imagen: ' + (e.message || 'error ' + r.statusCode) } };\n}\n\nreturn { json: { ...plan, ok: true, intento: 0, contenedor: cuerpo.id } };"
