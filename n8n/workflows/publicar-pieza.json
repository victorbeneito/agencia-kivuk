      ],
      "name": "IG estado contenedor",
      "alwaysOutputData": true,
      "id": "pb000015-0015-4015-8015-000000000015"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// El contador se lee de lo que entró en la espera, NO de \"IG leer contenedor\":\n// ese nodo solo se ejecuta una vez y siempre devolvería intento 0, así que el\n// tope de reintentos no se alcanzaría nunca y el bucle no terminaría.\nconst previo = $('IG esperar').item.json;\nconst r = $json || {};\nconst cuerpo = r.body || {};\nconst intento = (previo.intento || 0) + 1;\n\nconst estado = cuerpo.status_code || '';\n\n// Meta recomienda sondear una vez por minuto y no más de cinco. Aquí se sondea\n// más a menudo porque una imagen suele estar lista al instante; el tope de\n// intentos es lo que evita quedarse colgado.\nconst base = { ...previo, intento, listo: false, reintentar: false };\n\nif (estado === 'FINISHED' || estado === 'PUBLISHED') return { json: { ...base, listo: true } };\n\nif (estado === 'ERROR') {\n  return { json: { ...base, fallo: 'Instagram rechazó la imagen: ' + (cuerpo.status || 'sin detalle') } };\n}\nif (estado === 'EXPIRED') {\n  return { json: { ...base, fallo: 'El contenedor caducó antes de publicarse.' } };\n}\nif (intento >= 5) {\n  return { json: { ...base, fallo: 'Instagram sigue procesando la imagen tras ' + intento + ' intentos.' } };\n}\n\nreturn { json: { ...base, reintentar: true } };"
      },
