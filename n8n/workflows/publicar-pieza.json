      ],
      "name": "IG publicar",
      "alwaysOutputData": true,
      "id": "pb000019-0019-4019-8019-000000000019"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// A este nodo se llega por tres caminos y hay que distinguirlos: desde\n// \"IG publicar\" el item es la respuesta HTTP de Meta; desde los dos desvíos de\n// fallo es el plan, que ya trae el motivo en 'fallo'. La respuesta HTTP es la\n// única que trae statusCode.\nconst r = $json || {};\nconst desdeHttp = r.statusCode !== undefined;\nconst plan = desdeHttp ? $('IG ¿listo?').item.json : r;\n\nconst fin = (ok, extra) => ({\n  json: {\n    red: 'instagram',\n    content_item_id: plan.content_item_id,\n    usuario: plan.usuario,\n    ok,\n    ...extra,\n  },\n});\n\nif (!desdeHttp) return fin(false, { error: plan.fallo || 'Falló antes de publicar.' });\n\nconst cuerpo = r.body || {};\nif (r.statusCode >= 400 || cuerpo.error) {\n  const e = cuerpo.error || {};\n  return fin(false, { error: 'Instagram: ' + (e.message || 'error ' + r.statusCode) });\n}\n\nreturn fin(true, { post_id: cuerpo.id });"
      },
