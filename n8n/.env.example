# Copia este archivo a .env (no lo subas a git) y ajusta los valores.

POSTGRES_USER=n8n
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=n8n

# En local deja localhost. En el VPS (Fase 1.5) esto pasa a ser tu dominio,
# ej: n8n.tuagencia.com, con N8N_PROTOCOL=https y WEBHOOK_URL=https://n8n.tuagencia.com/
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/

# Solo producción (docker-compose.prod.yml). Clave con la que n8n cifra las
# credenciales que guarde. Generar una vez con `openssl rand -hex 32` y no
# perderla: sin ella, un servidor recreado no puede descifrar lo ya guardado.
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=Europe/Madrid

# Las usan los workflows (ver workflows/README.md). La service_role key salta RLS,
# así que solo debe vivir aquí y en el servidor, nunca en el navegador.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
OPENAI_API_KEY=sk-...

# Las usa el panel de Next.js (servicio `panel` de docker-compose.prod.yml).
# Estas dos SÍ llegan al navegador —de ahí el prefijo NEXT_PUBLIC_— y se
# incrustan al compilar la imagen, no al arrancarla: si las cambias, hay que
# reconstruir con `dc up -d --build panel`.
# La anon key es pública por diseño; quien protege los datos es RLS.
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Versión de la Graph API de Meta. Opcional: si no está, se usa v25.0.
META_API_VERSION=v25.0

# Secreto compartido entre el panel y el workflow `enviar-whatsapp`, que es el
# que manda los mensajes escritos a mano desde la bandeja. Lo eliges tú
# (`openssl rand -hex 32`) y se usa en los dos lados: n8n lo lee como
# PANEL_WEBHOOK_TOKEN y el panel como N8N_WEBHOOK_TOKEN, ambos desde aquí.
#
# Sin él, ese webhook queda abierto a internet y cualquiera que dé con la URL
# puede escribir por WhatsApp a los clientes del cliente. El workflow se niega a
# enviar si está vacío.
PANEL_WEBHOOK_TOKEN=elige-una-cadena-larga-y-aleatoria

# Token con el que Meta verifica el webhook de WhatsApp al darlo de alta. Lo
# eliges tú: es una contraseña compartida entre el panel de Meta y n8n, y no la
# emite nadie. Es el mismo para todos los clientes, porque la ruta del webhook
# (/webhook/whatsapp-kivuk) también lo es.
#
# Si lo cambias, hay que volver a verificar el webhook en el panel de Meta de
# cada app: n8n dejará de aceptar el token viejo en cuanto se reinicie.
META_VERIFY_TOKEN=elige-una-cadena-larga-y-aleatoria

# Solo para `scripts/conectar-meta.js`, que conecta una cuenta de Instagram o
# Facebook a un cliente (ver docs/conectar-meta.md). Los tokens de publicación
# NO se guardan aquí: acaban en la tabla `social_accounts`, uno por cliente.
# META_USER_TOKEN es el token corto del Explorador de la API y caduca en 1 hora;
# el script lo canjea por uno duradero y luego ya no hace falta.
META_APP_ID=
META_APP_SECRET=
META_USER_TOKEN=
